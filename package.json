{
  "name": "panic-button-escolar",
  "version": "3.4.0",
  "description": "Sistema de botón de pánico para colegios con WebSockets y Web Push",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "generate-vapid": "node -e \"const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log('VAPID_PUBLIC='+k.publicKey+'\\nVAPID_PRIVATE='+k.privateKey);\""
  },
  "keywords": ["panic-button", "emergency", "websocket", "pwa", "school"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "googleapis": "^140.0.0",
    "socket.io": "^4.6.1",
    "web-push": "^3.6.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
